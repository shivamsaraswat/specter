# Copy to .env for local use. Never commit .env.
PORT=3000

DB_HOST=localhost
DB_PORT=5432
DB_NAME=threats
DB_USER=postgres
DB_PASSWORD=change-me

# Long random string, e.g. `openssl rand -hex 32`
JWT_SECRET=change-me
JWT_EXPIRES_IN=8h

# The single login user, created/updated on startup
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
